    "recipeOfTheDay": {
      "id": "blt9999999999999999",
      "title": "Ofengemüse mit Kräuterquark",
      "difficulty": 1,
      "serving": {
        "type": "portions",
        "quantity": 4
      },
      "timeCooking": 35,
      "timePreparation": 20,
      "timeTotal": null,
      "preparation": {
        "steps": [
          {
            "description": "Den Backofen auf 200 °C Ober-/Unterhitze vorheizen. Die Kartoffeln waschen und in Spalten schneiden."
          },
          {
            "description": "Paprika, Zucchini und Zwiebel putzen und grob würfeln. Alles mit den Kartoffeln, den Tomaten, dem Öl, dem Paprikapulver und dem Salz mischen."
          },
          {
            "description": "Das Gemüse auf einem Backblech verteilen und etwa 35 Minuten backen. Nach der Hälfte der Zeit einmal wenden."
          },
          {
            "description": "Den Quark mit der Milch glatt rühren. Die Kräuter fein schneiden, unterheben und mit Salz abschmecken."
          }
        ]
      },
